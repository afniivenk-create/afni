<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Kombinasi di Kantin Ceria!</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fef08a 0%, #fed7aa 50%, #fbcfe8 100%);
            min-height: 100vh;
        }
        .bounce-custom {
            animation: bounce 2s infinite;
        }
        @keyframes pulse-scale {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-pulse-scale {
            animation: pulse-scale 1.5s infinite;
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col min-h-screen">

    <header class="bg-white/80 backdrop-blur-md shadow-md sticky top-0 z-50 px-4 py-3">
        <div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-amber-400 text-white p-2.5 rounded-2xl shadow-inner text-2xl">
                    <i class="fa-solid fa-cookie-bite"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg sm:text-xl text-amber-600 leading-tight">Misteri Kombinasi Kantin</h1>
                    <p class="text-xs text-slate-500">Pendekatan Penemuan & Eksplorasi Asyik</p>
                </div>
            </div>
            <!-- Wizard Tab Navigation -->
            <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-2xl shadow-inner w-full sm:w-auto justify-center">
                <button onclick="switchTab(1)" id="tab-btn-1" class="flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-amber-500 text-white shadow">
                    1. Eksplorasi
                </button>
                <button onclick="switchTab(2)" id="tab-btn-2" class="flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:text-amber-600">
                    2. Abstraksi
                </button>
                <button onclick="switchTab(3)" id="tab-btn-3" class="flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:text-amber-600">
                    3. Evaluasi
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-4xl w-full mx-auto p-4 sm:p-6 mb-12">

        <!-- ================= TAHAP 1: EKSPLORASI ================= -->
        <section id="tab-1" class="space-y-6">
            <div class="bg-white rounded-3xl p-5 sm:p-8 shadow-xl border-4 border-amber-200">
                <div class="inline-block bg-amber-100 text-amber-700 px-3 py-1 rounded-full text-xs font-bold mb-3">
                    <i class="fa-solid fa-compass mr-1"></i> Tahap 1: Eksplorasi Kontekstual
                </div>
                <h2 class="text-xl sm:text-2xl font-black text-slate-800 mb-2">Jajanan Kantin Rp 2.000 🧃🍩</h2>
                <p class="text-sm sm:text-base text-slate-600 mb-4">
                    Kamu membawa uang saku <strong>Rp 2.000</strong>. Di kantin tersedia jajanan seharga <strong>Rp 1.000</strong> per item. Pilih tepat <strong>2 jajanan berbeda</strong> untuk dimasukkan ke dalam Mangkok Kantin! Klik jajanan di bawah ini.
                </p>

                <!-- Status Uang & Pilihan -->
                <div class="flex flex-wrap justify-between items-center bg-amber-50 p-3 sm:p-4 rounded-2xl mb-6 border border-amber-200 gap-2">
                    <div class="flex items-center gap-2">
                        <span class="bg-emerald-500 text-white px-3 py-1 rounded-xl text-xs sm:text-sm font-bold shadow">
                            <i class="fa-solid fa-wallet mr-1"></i> Sisa Uang: Rp <span id="sisa-uang">2000</span>
                        </span>
                    </div>
                    <div class="text-xs sm:text-sm font-semibold text-slate-700">
                        Dipilih: <span id="jumlah-terpilih" class="text-amber-600 font-bold">0</span> / 2 Item
                    </div>
                    <div>
                        <button onclick="resetEksplorasi()" class="text-xs bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold px-3 py-1.5 rounded-xl transition-all">
                            <i class="fa-solid fa-rotate-right mr-1"></i> Reset Mangkok
                        </button>
                    </div>
                </div>

                <!-- Grid Item Jajanan & Mangkok -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Daftar Jajanan -->
                    <div>
                        <h3 class="text-sm font-bold text-slate-700 mb-3"><i class="fa-solid fa-store mr-1 text-amber-500"></i> Etalase Kantin (Klik untuk pilih):</h3>
                        <div class="grid grid-cols-2 gap-3" id="etalase-jajanan">
                            <!-- Rendered by JS -->
                        </div>
                    </div>

                    <!-- Mangkok Kantin -->
                    <div class="bg-amber-100/60 rounded-2xl p-4 border-2 border-dashed border-amber-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="text-sm font-bold text-amber-800"><i class="fa-solid fa-bowl-food mr-1"></i> Mangkok Kantin Kamu</h3>
                                <span class="text-xs bg-amber-200 text-amber-800 px-2 py-0.5 rounded-full font-semibold">Kapasitas: 2</span>
                            </div>
                            <div id="mangkok-items" class="grid grid-cols-2 gap-3 min-h-[140px] items-center">
                                <div class="col-span-2 text-center text-slate-400 text-sm py-8 italic flex flex-col items-center justify-center gap-1">
                                    <i class="fa-solid fa-hand-pointer text-xl animate-bounce">></i>
                                    <span>Belum ada makanan di mangkok. Klik 2 jajanan dari etalase!</span>
                                </div>
                            </div>
                        </div>

                        <div id="info-kombinasi-baru" class="mt-4 pt-3 border-t border-amber-200/60 text-xs font-semibold text-center text-amber-900 hidden">
                            ✨ Hore! Kombinasi berhasil dicatat!
                        </div>
                    </div>
                </div>

                <!-- Riwayat Kombinasi Unik -->
                <div class="mt-6 pt-6 border-t border-slate-200">
                    <h3 class="text-sm font-bold text-slate-700 mb-2 flex items-center justify-between">
                        <span><i class="fa-solid fa-list-check mr-1 text-emerald-500"></i> Daftar Kombinasi Unik yang Ditemukan:</span>
                        <span id="counter-kombinasi" class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-xl font-bold">0 dari 6 Kombinasi</span>
                    </h3>
                    <div id="riwayat-list" class="flex flex-wrap gap-2 mt-2">
                        <span class="text-xs text-slate-400 italic">Belum ada kombinasi tercatat. Temukan semuanya!</span>
                    </div>
                </div>

                <!-- Pertanyaan Pemantik Interaktif -->
                <div id="pertanyaan-pemantik-container" class="mt-8 bg-sky-50 border-2 border-sky-200 rounded-2xl p-4 sm:p-5 hidden">
                    <h3 class="text-base font-extrabold text-sky-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-lightbulb text-amber-500 text-xl"></i> Pertanyaan Pemantik Eksplorasi:
                    </h3>
                    <p class="text-sm text-slate-700 mb-4 font-medium">
                        Misalnya kamu memilih <strong>Kerupuk</strong> lalu <strong>Es Teh</strong>, apakah mangkokmu akan berbeda isinya jika kamu memilih <strong>Es Teh</strong> lalu <strong>Kerupuk</strong>? Apakah urutan pemilihan penting dalam mangkok jajanan ini?
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="opsi-pemantik">
                        <button onclick="jawabPemantik(false)" class="p-3 bg-white hover:bg-sky-100 border border-sky-300 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 text-left transition-all shadow-sm">
                            A. Berbeda, karena urutan memasukkan barang ke mangkok menentukan rasanya.
                        </button>
                        <button onclick="jawabPemantik(true)" class="p-3 bg-white hover:bg-sky-100 border border-sky-300 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 text-left transition-all shadow-sm">
                            B. Sama saja! Isi mangkok tetap Kerupuk dan Es Teh (Urutan tidak penting).
                        </button>
                    </div>
                    <div id="feedback-pemantik" class="mt-3 p-3 rounded-xl text-xs sm:text-sm font-bold hidden"></div>
                </div>

                <!-- Tombol Lanjut ke Tahap 2 -->
                <div id="btn-lanjut-1" class="mt-6 text-right hidden">
                    <button onclick="switchTab(2)" class="bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold px-6 py-3 rounded-2xl shadow-lg transition-all text-sm flex items-center gap-2 ml-auto">
                        <span>Lanjut ke Tahap 2: Abstraksi & Rumus</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= TAHAP 2: ABSTRAKSI ================= -->
        <section id="tab-2" class="space-y-6 hidden">
            <div class="bg-white rounded-3xl p-5 sm:p-8 shadow-xl border-4 border-orange-200">
                <div class="inline-block bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-bold mb-3">
                    <i class="fa-solid fa-brain mr-1"></i> Tahap 2: Abstraksi & Konstruksi Rumus
                </div>
                <h2 class="text-xl sm:text-2xl font-black text-slate-800 mb-2">Permainan 'Lebur' Permutasi ke Kombinasi 🧪</h2>
                <p class="text-sm sm:text-base text-slate-600 mb-6">
                    Dari 3 item jajanan (<span class="text-amber-600 font-bold">Kerupuk, Es Teh, Donat</span>), jika kita memilih 2 item dengan memperhatikan urutan (Permutasi), kita mendapatkan <strong>6 susunan</strong>. Namun, karena urutan dalam mangkok tidak penting, susunan yang isinya sama dilebur menjadi satu!
                </p>

                <!-- Animasi Permainan Lebur -->
                <div class="bg-orange-50 rounded-2xl p-4 sm:p-6 border border-orange-200 mb-6">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-6">
                        <div class="w-full md:w-1/2 text-center bg-white p-4 rounded-2xl shadow-sm border border-orange-200">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Permutasi (Urutan Penting)</span>
                            <div class="text-3xl font-black text-orange-600 mt-1">6 Susunan</div>
                            <p class="text-xs text-slate-500 mt-1">AB, BA, AC, CA, BC, CB</p>
                        </div>
                        <div class="text-2xl text-orange-400 font-bold animate-pulse">
                            <i class="fa-solid fa-arrows-down-to-line md:fa-arrow-right"></i>
                        </div>
                        <div class="w-full md:w-1/2 text-center bg-white p-4 rounded-2xl shadow-sm border border-orange-200">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Kombinasi (Urutan TIDAK Penting)</span>
                            <div class="text-3xl font-black text-emerald-600 mt-1">3 Kombinasi</div>
                            <p class="text-xs text-slate-500 mt-1">AB, AC, BC (Dilebur dibagi 2!)</p>
                        </div>
                    </div>

                    <div class="text-center">
                        <button onclick="jalankanLeburAnimasi()" id="btn-lebur" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-6 py-2.5 rounded-xl shadow transition-all text-sm">
                            <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Visualisasikan Peleburan (Bagi dengan 2!)
                        </button>
                    </div>

                    <div id="lebur-result-box" class="mt-4 p-4 bg-white rounded-xl border border-orange-200 hidden text-sm text-slate-700 animate-fadeIn">
                        <p class="font-bold text-orange-800 mb-1">💡 Mengapa dibagi 2 (atau $2!$)?</p>
                        <p>Karena setiap 2 item (misal Kerupuk & Es Teh) memiliki <strong>2! = 2 × 1 = 2</strong> cara penyusunan (Kerupuk-Es Teh dan Es Teh-Kerupuk). Untuk menghilangkan faktor urutan, jumlah permutasi harus dibagi dengan faktorial jumlah objek yang dipilih ($r!$).</p>
                    </div>
                </div>

                <!-- Perakitan Rumus Interaktif -->
                <div class="bg-slate-50 rounded-2xl p-4 sm:p-6 border border-slate-200">
                    <h3 class="text-base font-bold text-slate-800 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-puzzle-piece text-amber-500"></i> Merakit Rumus Kombinasi $C(n,r)$
                    </h3>
                    <p class="text-sm text-slate-600 mb-4">
                        Susun kepingan rumus di bawah ini ke tempat kosong yang tepat untuk membentuk rumus Kombinasi yang utuh!
                    </p>

                    <!-- Slot Tujuan Rumus -->
                    <div class="flex flex-wrap items-center justify-center gap-2 bg-white p-4 sm:p-6 rounded-2xl shadow-inner border-2 border-dashed border-slate-300 mb-6">
                        <span class="text-lg font-bold text-slate-700">$C(n,r)$</span>
                        <span class="text-lg font-bold text-slate-700">=</span>
                        <!-- Slot 1 -->
                        <div id="slot-1" ondragover="allowDrop(event)" ondrop="dropRumus(event, 1)" class="w-32 h-12 bg-slate-100 border-2 border-slate-300 rounded-xl flex items-center justify-center text-sm font-bold text-slate-400 transition-all">
                            [ Pangkas / Atas ]
                        </div>
                        <span class="text-lg font-bold text-slate-700">/</span>
                        <!-- Slot 2 -->
                        <div id="slot-2" ondragover="allowDrop(event)" ondrop="dropRumus(event, 2)" class="w-24 h-12 bg-slate-100 border-2 border-slate-300 rounded-xl flex items-center justify-center text-sm font-bold text-slate-400 transition-all">
                            [ Bawah ]
                        </div>
                    </div>

                    <!-- Kepingan Pilihan (Drag / Click to place) -->
                    <div class="mb-4">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 block">Kepingan Rumus (Seret atau Klik):</span>
                        <div class="flex flex-wrap gap-3" id="kepingan-container">
                            <div draggable="true" ondragstart="dragRumus(event, 'P(n,r)')" onclick="klikKepingan('P(n,r)')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-4 py-2 rounded-xl shadow cursor-grab active:cursor-grabbing text-sm transition-transform hover:scale-105">
                                P(n,r)
                            </div>
                            <div draggable="true" ondragstart="dragRumus(event, 'r!')" onclick="klikKepingan('r!')" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-4 py-2 rounded-xl shadow cursor-grab active:cursor-grabbing text-sm transition-transform hover:scale-105">
                                r!
                            </div>
                            <div draggable="true" ondragstart="dragRumus(event, 'n!')" onclick="klikKepingan('n!')" class="bg-indigo-500 hover:bg-indigo-600 text-white font-bold px-4 py-2 rounded-xl shadow cursor-grab active:cursor-grabbing text-sm transition-transform hover:scale-105">
                                n!
                            </div>
                        </div>
                    </div>

                    <!-- Pesan Sukses Perumusan -->
                    <div id="rumus-sukses-box" class="p-4 bg-emerald-100 border border-emerald-300 rounded-2xl text-emerald-900 font-bold text-center hidden animate-pulse-scale">
                        🎉 Hebat! Rumus Kombinasi Berhasil Dirakit: <br>
                        <span class="text-lg text-emerald-800">$C(n,r) = \frac{P(n,r)}{r!} = \frac{n!}{(n-r)! \cdot r!}$</span>
                    </div>

                    <div class="mt-6 text-right">
                        <button onclick="switchTab(3)" class="bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold px-6 py-3 rounded-2xl shadow-lg transition-all text-sm flex items-center gap-2 ml-auto">
                            <span>Lanjut ke Tahap 3: Evaluasi Soal</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= TAHAP 3: EVALUASI ================= -->
        <section id="tab-3" class="space-y-6 hidden">
            <div class="bg-white rounded-3xl p-5 sm:p-8 shadow-xl border-4 border-emerald-200">
                <div class="inline-block bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-xs font-bold mb-3">
                    <i class="fa-solid fa-award mr-1"></i> Tahap 3: Evaluasi & Latihan Kontekstual
                </div>
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                    <h2 class="text-xl sm:text-2xl font-black text-slate-800">Kuis Tantangan Kombinasi 🏆</h2>
                    <div class="bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-xl text-xs font-bold text-emerald-800">
                        Soal <span id="current-soal-num">1</span> dari 10
                    </div>
                </div>

                <!-- Soal Container -->
                <div id="quiz-card" class="bg-slate-50 border border-slate-200 rounded-2xl p-5 mb-6">
                    <p id="soal-teks" class="text-sm sm:text-base font-semibold text-slate-800 mb-4">
                        <!-- Loaded by JS -->
                    </p>
                    <div class="grid grid-cols-1 gap-3" id="pilihan-container">
                        <!-- Options loaded by JS -->
                    </div>
                </div>

                <!-- Pembahasan & Navigasi Soal -->
                <div id="pembahasan-box" class="p-4 bg-amber-50 border border-amber-200 rounded-2xl text-xs sm:text-sm text-slate-700 mb-6 hidden">
                    <span class="font-bold text-amber-900 block mb-1"><i class="fa-solid fa-circle-info mr-1"></i> Pembahasan:</span>
                    <p id="pembahasan-teks"></p>
                </div>

                <div class="flex justify-between items-center">
                    <button onclick="prevSoal()" id="btn-prev" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2 rounded-xl text-xs sm:text-sm transition-all disabled:opacity-50" disabled>
                        <i class="fa-solid fa-arrow-left mr-1"></i> Sebelumnya
                    </button>
                    <button onclick="nextSoal()" id="btn-next" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2 rounded-xl text-xs sm:text-sm transition-all shadow">
                        Selanjutnya <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>

                <!-- Hasil Akhir Kuis (Hidden by default) -->
                <div id="quiz-result-container" class="hidden text-center py-8">
                    <div class="inline-block p-4 bg-amber-100 text-amber-600 rounded-full text-5xl mb-4 shadow-inner">
                        <i id="result-icon" class="fa-solid fa-trophy"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-800 mb-2">Kuis Selesai! 🎉</h3>
                    <p class="text-slate-600 mb-4 text-sm sm:text-base">Skor Akhir Kamu:</p>
                    <div class="text-4xl font-black text-emerald-600 mb-2"><span id="final-score">0</span> / 100</div>
                    <div id="badge-pujian" class="inline-block px-4 py-2 bg-emerald-100 text-emerald-800 rounded-2xl font-bold text-sm mb-6 shadow-sm">
                        Luar Biasa! Master Kombinasi Kantin!
                    </div>
                    <div>
                        <button onclick="resetKuis()" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-6 py-3 rounded-2xl shadow-lg transition-all text-sm">
                            <i class="fa-solid fa-rotate-right mr-1"></i> Ulangi Kuis
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-white/60 backdrop-blur-md text-center py-4 text-xs text-slate-500 border-t border-slate-200/60">
        <p>Aplikasi Interaktif Pembelajaran Kombinasi • Pendekatan Penemuan & Kontekstual Kantin Sekolah</p>
    </footer>

    <script>
        let currentTab = 1;
        
        // Tahap 1 State
        const jajananList = [
            { id: 1, nama: "Kerupuk", harga: 1000, icon: "fa-cookie", color: "bg-amber-100 text-amber-700 border-amber-300" },
            { id: 2, nama: "Es Teh", harga: 1000, icon: "fa-cup-straw-soda", color: "bg-sky-100 text-sky-700 border-sky-300" },
            { id: 3, nama: "Donat", harga: 1000, icon: "fa-donut", color: "bg-pink-100 text-pink-700 border-pink-300" },
            { id: 4, nama: "Roti", harga: 1000, icon: "fa-bread-slice", color: "bg-orange-100 text-orange-700 border-orange-300" }
        ];
        let mangkokTerpilih = [];
        let riwayatKombinasi = [];
        let sisaUang = 2000;
        let sudahJawabPemantik = false;

        // Tahap 2 State
        let slot1Isi = null;
        let slot2Isi = null;

        // Tahap 3 State (Evaluasi 10 Soal)
        let activeSoalIdx = 0;
        let userAnswers = Array(10).fill(null);
        let showExplanation = Array(10).fill(false);

        const soalKuis = [
            {
                tanya: "1. Dari 5 orang pengurus OSIS, akan dipilih 2 orang untuk mewakili rapat di aula. Berapa banyak cara pemilihan pengurus tersebut?",
                pilihan: ["A. 5 cara", "B. 10 cara", "C. 20 cara", "D. 25 cara"],
                kunci: 1,
                pembahasan: "Menggunakan kombinasi C(5,2) = 5! / (2! 3!) = (5 × 4) / (2 × 1) = 10 cara."
            },
            {
                tanya: "2. Ibu membeli 6 jenis buah di pasar, dan anak diminta memilih 3 jenis buah untuk dibuatkan jus campuran. Banyak cara memilih buah adalah...",
                pilihan: ["A. 15 cara", "B. 20 cara", "C. 30 cara", "D. 120 cara"],
                kunci: 1,
                pembahasan: "C(6,3) = 6! / (3! 3!) = (6 × 5 × 4) / (3 × 2 × 1) = 20 cara."
            },
            {
                tanya: "3. Dalam sebuah ulangan matematika, siswa wajib mengerjakan 4 soal dari 7 soal yang tersedia. Berapa banyak pilihan kombinasi soal yang dapat dikerjakan siswa?",
                pilihan: ["A. 24 cara", "B. 28 cara", "C. 35 cara", "D. 42 cara"],
                kunci: 2,
                pembahasan: "C(7,4) = C(7,3) = (7 × 6 × 5) / (3 × 2 × 1) = 35 cara."
            },
            {
                tanya: "4. Di toko buku, tersedia 8 buku novel yang menarik. Budi hanya memiliki cukup uang untuk membeli 2 buku saja. Berapa banyak cara Budi memilih 2 buku dari 8 buku tersebut?",
                pilihan: ["A. 16 cara", "B. 28 cara", "C. 56 cara", "D. 64 cara"],
                kunci: 1,
                pembahasan: "C(8,2) = (8 × 7) / (2 × 1) = 28 cara."
            },
            {
                tanya: "5. Sebuah kotak berisi 4 bola merah dan 3 bola putih. Jika diambil 3 bola sekaligus secara acak dari kotak tersebut, berapa banyak cara pengambilan 2 bola merah dan 1 bola putih?",
                pilihan: ["A. 12 cara", "B. 18 cara", "C. 24 cara", "D. 30 cara"],
                kunci: 1,
                pembahasan: "C(4,2) × C(3,1) = ((4×3)/(2×1)) × 3 = 6 × 3 = 18 cara."
            },
            {
                tanya: "6. Pada pembentukan tim bola voli dari 9 orang pemain andalan, akan dipilih 6 orang inti yang turun ke lapangan. Berapa banyak susunan tim yang mungkin?",
                pilihan: ["A. 54 cara", "B. 72 cara", "C. 84 cara", "D. 126 cara"],
                kunci: 2,
                pembahasan: "C(9,6) = C(9,3) = (9 × 8 × 7) / (3 × 2 × 1) = 84 cara."
            },
            {
                tanya: "7. Dari 10 anggota klub seni rupa, akan dipilih 3 pengurus inti (ketua, sekretaris, bendahara dianggap setara/tanpa jabatan khusus). Banyak cara pemilihan adalah...",
                pilihan: ["A. 120 cara", "B. 240 cara", "C. 720 cara", "D. 1.000 cara"],
                kunci: 0,
                pembahasan: "C(10,3) = (10 × 9 × 8) / (3 × 2 × 1) = 120 cara."
            },
            {
                tanya: "8. Seorang petani ingin membeli 3 ekor kambing dari seorang peternak yang memiliki 7 ekor kambing sehat. Banyak cara pemilihan kambing tersebut adalah...",
                pilihan: ["A. 21 cara", "B. 35 cara", "C. 42 cara", "D. 210 cara"],
                kunci: 1,
                pembahasan: "C(7,3) = (7 × 6 × 5) / (3 × 2 × 1) = 35 cara."
            },
            {
                tanya: "9. Dalam soal ujian terdapat 10 nomor pilihan. Jika siswa harus menjawab 5 nomor ganjil dan 2 nomor genap dari total soal yang ada (misal 5 ganjil dan 5 genap), berapa kombinasi pilihan soal nomor ganjil dari 5 nomor ganjil yang tersedia?",
                pilihan: ["A. 1 cara", "B. 5 cara", "C. 10 cara", "D. 25 cara"],
                kunci: 0,
                pembahasan: "C(5,5) = 1 cara (semua nomor ganjil harus dipilih)."
            },
            {
                tanya: "10. Mengapa rumus kombinasi menggunakan pembagian dengan faktorial $r!$ di bagian penyebut?",
                pilihan: ["A. Karena nilai akhir harus selalu diperbesar", "B. Karena urutan pengambilan objek tidak diperhatikan (diabaikan)", "C. Karena jumlah item selalu genap", "D. Untuk menghitung keliling lingkaran"],
                kunci: 1,
                pembahasan: "Pembagian dengan r! berfungsi untuk menghilangkan duplikasi susunan yang diakibatkan oleh perbedaan urutan (karena dalam kombinasi AB dianggap sama dengan BA)."
            }
        ];

        function switchTab(tabNum) {
            currentTab = tabNum;
            for (let i = 1; i <= 3; i++) {
                document.getElementById(`tab-${i}`).classList.add('hidden');
                document.getElementById(`tab-btn-${i}`).className = "flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:text-amber-600";
            }
            document.getElementById(`tab-${tabNum}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tabNum}`);
            activeBtn.className = "flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-amber-500 text-white shadow";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderEtalase() {
            const etalaseEl = document.getElementById('etalase-jajanan');
            etalaseEl.innerHTML = '';
            jajananList.forEach(item => {
                const isTerpilih = mangkokTerpilih.some(m => m.id === item.id);
                etalaseEl.innerHTML += `
                    <button onclick="pilihJajanan(${item.id})" ${isTerpilih ? 'disabled' : ''} class="p-3 rounded-2xl border-2 ${item.color} flex flex-col items-center justify-center gap-1 transition-all shadow-sm ${isTerpilih ? 'opacity-40 cursor-not-allowed grayscale' : 'hover:scale-105 cursor-pointer'}">
                        <i class="fa-solid ${item.icon} text-2xl"></i>
                        <span class="font-bold text-xs">${item.nama}</span>
                        <span class="text-[10px] opacity-75">Rp ${item.harga}</span>
                    </button>
                `;
            });
        }

        function renderMangkok() {
            const mangkokEl = document.getElementById('mangkok-items');
            document.getElementById('jumlah-terpilih').innerText = mangkokTerpilih.length;
            document.getElementById('sisa-uang').innerText = sisaUang;

            if (mangkokTerpilih.length === 0) {
                mangkokEl.innerHTML = `
                    <div class="col-span-2 text-center text-slate-400 text-sm py-8 italic flex flex-col items-center justify-center gap-1">
                        <i class="fa-solid fa-hand-pointer text-xl animate-bounce"></i>
                        <span>Belum ada makanan di mangkok. Klik 2 jajanan dari etalase!</span>
                    </div>
                `;
                return;
            }

            mangkokEl.innerHTML = '';
            mangkokTerpilih.forEach(item => {
                mangkokEl.innerHTML += `
                    <div class="bg-white p-2.5 rounded-xl shadow-sm border border-amber-200 flex items-center justify-between animate-fadeIn">
                        <div class="flex items-center gap-2">
                            <div class="p-2 rounded-lg bg-amber-100 text-amber-700 text-sm">
                                <i class="fa-solid ${item.icon}"></i>
                            </div>
                            <span class="font-bold text-xs text-slate-700">${item.nama}</span>
                        </div>
                        <button onclick="hapusDariMangkok(${item.id})" class="text-rose-500 hover:text-rose-700 text-xs p-1">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `;
            });
        }

        function pilihJajanan(id) {
            if (mangkokTerpilih.length >= 2) return;
            const item = jajananList.find(j => j.id === id);
            if (item && sisaUang >= item.harga) {
                mangkokTerpilih.push(item);
                sisaUang -= item.harga;
                renderEtalase();
                renderMangkok();

                if (mangkokTerpilih.length === 2) {
                    catatKombinasiUnik();
                }
            }
        }

        function hapusDariMangkok(id) {
            const idx = mangkokTerpilih.findIndex(j => j.id === id);
            if (idx !== -1) {
                sisaUang += mangkokTerpilih[idx].harga;
                mangkokTerpilih.splice(idx, 1);
                renderEtalase();
                renderMangkok();
            }
        }

        function resetEksplorasi() {
            mangkokTerpilih = [];
            sisaUang = 2000;
            renderEtalase();
            renderMangkok();
        }

        function catatKombinasiUnik() {
            // Sort to ensure uniqueness regardless of selection order
            const namaSorted = mangkokTerpilih.map(j => j.nama).sort().join(" & ");
            
            if (!riwayatKombinasi.includes(namaSorted)) {
                riwayatKombinasi.push(namaSorted);
                updateRiwayatTampilan();
                
                const infoMsg = document.getElementById('info-kombinasi-baru');
                infoMsg.classList.remove('hidden');
                setTimeout(() => infoMsg.classList.add('hidden'), 3000);
            }

            if (riwayatKombinasi.length >= 3 && !sudahJawabPemantik) {
                document.getElementById('pertanyaan-pemantik-container').classList.remove('hidden');
            }
        }

        function updateRiwayatTampilan() {
            const riwayatListEl = document.getElementById('riwayat-list');
            document.getElementById('counter-kombinasi').innerText = `${riwayatKombinasi.length} dari 6 Kombinasi`;
            
            riwayatListEl.innerHTML = '';
            riwayatKombinasi.forEach((kombo, idx) => {
                riwayatListEl.innerHTML += `
                    <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 px-3 py-1.5 rounded-xl text-xs font-bold shadow-sm animate-fadeIn">
                        <i class="fa-solid fa-check mr-1"></i> #${idx+1}: ${kombo}
                    </span>
                `;
            });
        }

        function jawabPemantik(isBenar) {
            sudahJawabPemantik = true;
            const feedbackEl = document.getElementById('feedback-pemantik');
            feedbackEl.classList.remove('hidden');
            if (isBenar) {
                feedbackEl.className = "mt-3 p-3 rounded-xl text-xs sm:text-sm font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                feedbackEl.innerHTML = "🎉 Tepat Sekali! Urutan pemilihan tidak penting dalam mangkok jajanan. (Kerupuk + Es Teh) sama dengan (Es Teh + Kerupuk). Inilah inti dari konsep <strong>Kombinasi</strong>!";
                document.getElementById('btn-lanjut-1').classList.remove('hidden');
            } else {
                feedbackEl.className = "mt-3 p-3 rounded-xl text-xs sm:text-sm font-bold bg-rose-100 text-rose-800 border border-rose-300";
                feedbackEl.innerHTML = "❌ Kurang tepat. Coba bayangkan mangkok kantinmu: apakah isi mangkoknya berubah jika kamu ambil minumnya dulu baru kerupuknya? Tentu isinya tetap sama! Coba pilih opsi B.";
                sudahJawabPemantik = false;
            }
        }

        function jalankanLeburAnimasi() {
            const box = document.getElementById('lebur-result-box');
            box.classList.remove('hidden');
        }

        function allowDrop(ev) {
            ev.preventDefault();
        }

        function dragRumus(ev, data) {
            ev.dataTransfer.setData("text", data);
        }

        function dropRumus(ev, slotNum) {
            ev.preventDefault();
            const data = ev.dataTransfer.getData("text");
            isiSlot(slotNum, data);
        }

        function klikKepingan(data) {
            if (!slot1Isi) {
                isiSlot(1, data);
            } else if (!slot2Isi) {
                isiSlot(2, data);
            } else {
                // Reset slots if full
                slot1Isi = null;
                slot2Isi = null;
                isiSlot(1, data);
            }
        }

        function isiSlot(slotNum, val) {
            if (slotNum === 1) {
                slot1Isi = val;
                const slotEl = document.getElementById('slot-1');
                slotEl.innerText = val;
                slotEl.className = "w-32 h-12 bg-amber-100 border-2 border-amber-400 rounded-xl flex items-center justify-center text-sm font-bold text-amber-800 shadow-sm transition-all";
            } else {
                slot2Isi = val;
                const slotEl = document.getElementById('slot-2');
                slotEl.innerText = val;
                slotEl.className = "w-24 h-12 bg-emerald-100 border-2 border-emerald-400 rounded-xl flex items-center justify-center text-sm font-bold text-emerald-800 shadow-sm transition-all";
            }

            // Check if correct: C(n,r) = P(n,r) / r!
            if (slot1Isi === 'P(n,r)' && slot2Isi === 'r!') {
                document.getElementById('rumus-sukses-box').classList.remove('hidden');
            } else {
                document.getElementById('rumus-sukses-box').classList.add('hidden');
            }
        }

        function renderSoal() {
            const soal = soalKuis[activeSoalIdx];
            document.getElementById('current-soal-num').innerText = activeSoalIdx + 1;
            document.getElementById('soal-teks').innerText = soal.tanya;

            const pilihanEl = document.getElementById('pilihan-container');
            pilihanEl.innerHTML = '';

            soal.pilihan.forEach((pil, idx) => {
                const isSelected = userAnswers[activeSoalIdx] === idx;
                const isCorrect = soal.kunci === idx;
                let btnStyle = "bg-white hover:bg-slate-100 border-slate-300 text-slate-700";

                if (userAnswers[activeSoalIdx] !== null) {
                    if (isCorrect) {
                        btnStyle = "bg-emerald-100 border-emerald-400 text-emerald-900 font-bold";
                    } else if (isSelected && !isCorrect) {
                        btnStyle = "bg-rose-100 border-rose-400 text-rose-900";
                    } else {
                        btnStyle = "bg-white border-slate-200 opacity-60";
                    }
                }

                pilihanEl.innerHTML += `
                    <button onclick="pilihJawaban(${idx})" class="p-3.5 rounded-xl border-2 text-left text-xs sm:text-sm transition-all shadow-sm ${btnStyle}">
                        ${pil}
                    </button>
                `;
            });

            // Pembahasan box
            const pembahasanBox = document.getElementById('pembahasan-box');
            if (userAnswers[activeSoalIdx] !== null) {
                pembahasanBox.classList.remove('hidden');
                document.getElementById('pembahasan-teks').innerText = soal.pahasan || soal.pembahasan;
            } else {
                pembahasanBox.classList.add('hidden');
            }

            // Button state
            document.getElementById('btn-prev').disabled = activeSoalIdx === 0;
            if (activeSoalIdx === 9) {
                document.getElementById('btn-next').innerText = "Selesai & Lihat Skor";
            } else {
                document.getElementById('btn-next').innerHTML = `Selanjutnya <i class="fa-solid fa-arrow-right ml-1"></i>`;
            }
        }

        function pilihJawaban(idx) {
            if (userAnswers[activeSoalIdx] !== null) return; // Locked once answered
            userAnswers[activeSoalIdx] = idx;
            renderSoal();
        }

        function nextSoal() {
            if (activeSoalIdx < 9) {
                activeSoalIdx++;
                renderSoal();
            } else {
                tampilkanHasilKuis();
            }
        }

        function prevSoal() {
            if (activeSoalIdx > 0) {
                activeSoalIdx--;
                renderSoal();
            }
        }

        function tampilkanHasilKuis() {
            let benarCount = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === soalKuis[idx].kunci) benarCount++;
            });

            const skorAkhir = benarCount * 10;
            document.getElementById('final-score').innerText = skorAkhir;

            const badgeEl = document.getElementById('badge-pujian');
            if (skorAkhir === 100) {
                badgeEl.innerText = "🌟 Sempurna! Master Kombinasi Sejati!";
            } else if (skorAkhir >= 70) {
                badgeEl.innerText = "👏 Hebat! Pemahaman Kombinasi Kamu Sangat Baik!";
            } else {
                badgeEl.innerText = "💪 Tetap Semangat! Coba pelajari ulang Tahap 1 & 2 ya!";
            }

            document.getElementById('quiz-card').classList.add('hidden');
            document.getElementById('pembahasan-box').classList.add('hidden');
            document.getElementById('btn-prev').classList.add('hidden');
            document.getElementById('btn-next').classList.add('hidden');
            document.getElementById('quiz-result-container').classList.remove('hidden');
        }

        function resetKuis() {
            userAnswers = Array(10).fill(null);
            activeSoalIdx = 0;
            document.getElementById('quiz-card').classList.remove('hidden');
            document.getElementById('btn-prev').classList.remove('hidden');
            document.getElementById('btn-next').classList.remove('hidden');
            document.getElementById('quiz-result-container').classList.add('hidden');
            renderSoal();
        }

        // Initialize on load
        window.onload = function() {
            renderEtalase();
            renderMangkok();
            renderSoal();
        };
    </script>
</body>
</html>
